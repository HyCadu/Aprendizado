+            dirs.append(os.path.join(la, "Microsoft", "WinGet", "Links"))
+            dirs += glob.glob(os.path.join(la, "Microsoft", "WinGet", "Packages", "Gyan.FFmpeg*", "*", "bin"))
+        dirs.append(r"C:\ffmpeg\bin")
+    if IS_MAC:
+        dirs += ["/opt/homebrew/bin", "/usr/local/bin"]
+    return dirs
+
