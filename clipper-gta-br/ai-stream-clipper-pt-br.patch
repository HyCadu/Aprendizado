+def ffmpeg() -> str:
+    p = which("ffmpeg")
+    if not p:
+        raise SystemExit("ffmpeg not found. Run: python -I scripts/clipper.py setup --install")
+    return p
+
+
+def ffprobe() -> str:
+    p = which("ffprobe")
+    if not p:
+        raise SystemExit("ffprobe not found. Run: python -I scripts/clipper.py setup --install")
+    return p
