index 0000000..7cd4f08
--- /dev/null
+++ b/scripts/cl_translate.py
@@ -0,0 +1,134 @@
+"""Translated captions: an English video with pt-BR captions, or a Brazilian video with English captions.
+
+Flow:
+  1. `clipper.py translate JOB` splits the speech of every checked pick into short phrases with exact
+     times and writes `translate.md` (to read) + `translation.todo.json` (template).
+  2. Claude writes `translation.json`: one translated line per phrase, same order and count.
+  3. `render` sees translation.json and burns the translated captions: each phrase is on screen exactly
+     while the original phrase is spoken; its words light up spread over that time (by length).
+"""
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+from cl_common import fmt_ts, read_json, write_json, write_text
+
+END = (".", "!", "?", "…")
+GAP_SPLIT = 0.7      # silence that always starts a new phrase (s)
+MAX_WORDS = 14
+MAX_SECS = 5.0
+LANG_NAMES = {"pt": "português do Brasil (pt-BR)", "en": "inglês (English)", "es": "espanhol", "ru": "russo"}
+# Como traduzir, por idioma de destino (vai no topo do translate.md).
+STYLE = {
+    "pt": ("Tradução natural e curta, como legenda de canal de cortes brasileiro (\"Puta merda!\", \"Bora, "
+           "porra!\", \"Esse jogo é de outra geração\"): adapte gíria e palavrão, não traduza palavra por palavra."),
+    "en": ("Write natural spoken English, the way a US clip channel captions a stream (\"Bro, no way!\", "
+           "\"Let's go!\", \"This game is next gen\"): adapt Brazilian slang and swearing (mano = bro, porra = "
+           "damn / f*ck, caralho = holy sh*t, tá ligado = you know), never word for word."),
+}
+
+
+def clip_words(words, a, b):
+    return [w for w in words if w["e"] > a and w["s"] < b]
+
+
+def phrases(ws):
+    """Split the clip's words into short phrases: sentence end, long pause, or too long."""
+    out, cur = [], []
+    for w in ws:
+        if cur:
+            prev = cur[-1]
+            gap = w["s"] - prev["e"]
+            pw = prev["w"].rstrip()
+            span = w["e"] - cur[0]["s"]
+            if (pw.endswith(END) or gap > GAP_SPLIT or len(cur) >= MAX_WORDS or span > MAX_SECS
+                    or (pw.endswith(",") and len(cur) >= 6)):
+                out.append(cur)
+                cur = []
+        cur.append(w)
+    if cur:
+        out.append(cur)
+    return [{"s": round(p[0]["s"], 2), "e": round(p[-1]["e"], 2), "src": " ".join(x["w"].strip() for x in p)}
+            for p in out]
+
+
+def _key(p):
+    return f"{p['start']:.2f}-{p['end']:.2f}"
+
+
+def prepare(job: Path, to: str = "pt") -> dict:
+    meta = read_json(job / "job.json") or {}
+    chk = read_json(job / "moments.checked.json")
+    if not chk:
+        raise SystemExit("Run `check` first: moments.checked.json is missing")
+    words = read_json(job / "transcript" / "words.json", [])
+    src_lang = meta.get("language", "en")
+    todo = {"from": src_lang, "to": to, "clips": {}}
+    md = [f"# Tradução das legendas: {meta.get('title', '')}",
+          f"De {LANG_NAMES.get(src_lang, src_lang)} para {LANG_NAMES.get(to, to)}.", "",
+          "Escreva `translation.json` com o mesmo formato de `translation.todo.json`: em cada clipe, "
+          "`lines` tem exatamente uma linha traduzida por frase, na mesma ordem (pode ser \"\" para "
+          "barulho / frase sem sentido).", "",
+          STYLE.get(to, STYLE["pt"]) + " Mantenha nomes próprios. Cada linha só aparece enquanto a frase "
+          "original é falada: frase de 1 s pede 2-4 palavras.", ""]
+    for p in sorted(chk["picks"], key=lambda q: q["order"]):
+        ph = phrases(clip_words(words, p["start"], p["end"]))
+        todo["clips"][str(p["order"])] = {"key": _key(p), "src": [x["src"] for x in ph], "lines": []}
+        md += [f"## Clipe {p['order']}: {fmt_ts(p['start'])} - {fmt_ts(p['end'])} ({len(ph)} frases)", ""]
+        md += [f"{i}. [{x['s'] - p['start']:.1f}-{x['e'] - p['start']:.1f} s] {x['src']}" for i, x in enumerate(ph, 1)]
+        md.append("")
+    write_json(job / "translation.todo.json", todo)
+    write_text(job / "translate.md", "\n".join(md) + "\n")
+    return todo
+
+
+def load(job: Path, picks) -> dict:
+    """translation.json validated against the current checked picks -> {order: [lines]}.
+    Raises SystemExit if it is out of date (cuts changed after translating)."""
+    tr = read_json(job / "translation.json")
+    if not tr:
+        return {}
+    words = read_json(job / "transcript" / "words.json", [])
+    clips = tr.get("clips") or {}
+    out, errs = {}, []
+    for p in picks:
+        c = clips.get(str(p["order"]))
+        if c is None:
+            errs.append(f"clipe {p['order']}: não está em translation.json")
+            continue
+        n = len(phrases(clip_words(words, p["start"], p["end"])))
+        lines = c.get("lines") or []
+        if c.get("key") and c["key"] != _key(p):
+            errs.append(f"clipe {p['order']}: o corte mudou depois da tradução (rode translate de novo)")
+        elif len(lines) != n:
+            errs.append(f"clipe {p['order']}: {len(lines)} linhas traduzidas para {n} frases")
+        else:
+            out[p["order"]] = [str(x) for x in lines]
+    if errs:
+        raise SystemExit("translation.json inválido: " + "; ".join(errs))
+    return {"to": tr.get("to", "pt"), "lines": out}
+
+
+def translated_words(ws, lines):
+    """Synthetic word list in the target language with times: each phrase's translated words are
+    spread over the original phrase's span, weighted by length (longer words stay lit longer)."""
+    out = []
+    phs = phrases(ws)
+    for k, (ph, line) in enumerate(zip(phs, lines)):
+        toks = [t for t in re.split(r"\s+", line.strip()) if t]
+        if not toks:
+            continue
+        s, e = ph["s"], ph["e"]
+        span = max(e - s, 0.25 * len(toks))   # a short "Wow." translated to more words needs room
+        if k + 1 < len(phs):
+            span = min(span, max(e - s, phs[k + 1]["s"] - 0.05 - s))
+        span = max(span, 0.1)
+        weights = [len(re.sub(r"\W", "", t)) + 2 for t in toks]
+        tot = float(sum(weights))
+        t = s
+        for tok, wgt in zip(toks, weights):
+            d = span * wgt / tot
+            out.append({"s": round(t, 3), "e": round(t + d - 0.02, 3), "w": tok})
+            t += d
+    return out
diff --git a/scripts/cl_whispercpp.py b/scripts/cl_whispercpp.py
new file mode 100644
index 0000000..df79b3f
--- /dev/null
+++ b/scripts/cl_whispercpp.py
@@ -0,0 +1,386 @@
+"""Transcription on AMD / Intel GPUs (Windows): whisper.cpp built with Vulkan.
+
+faster-whisper (CTranslate2) only runs on NVIDIA. whisper.cpp has no ready Vulkan build for Windows, so
+setup --vulkan installs CMake, the Vulkan SDK and the VS C++ Build Tools with winget and compiles
+whisper-cli once into ~/.ai-stream-clipper/whispercpp/.
+
+Speech regions come from faster-whisper's Silero VAD (whisper.cpp's own --vad moves segment times back
+to the original timeline but not word times). The speech is glued into one wav, whisper-cli transcribes
+it with DTW word timestamps, and the word times are mapped back to the stream timeline here.
+"""
+from __future__ import annotations
+
+import glob
+import json
+import os
+import re
+import subprocess
+import tempfile
+import urllib.request
+import wave
+from pathlib import Path
+
+import numpy as np
+
+from cl_common import CONFIG_DIR, IS_WIN, Timer, fmt_ts, load_config, log, which
+
+TAG = "v1.9.5"
+REPO = "https://github.com/ggml-org/whisper.cpp"
+WCPP_DIR = CONFIG_DIR / "whispercpp"
+SRC_DIR = WCPP_DIR / "src"
+BUILD_DIR = WCPP_DIR / "build"
+DTW_PRESET = {"large-v3-turbo": "large.v3.turbo", "large-v3": "large.v3", "medium": "medium",
+              "small": "small", "base": "base", "tiny": "tiny"}
+MODEL_URL = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-{}.bin"
+WINGET_DEPS = [
+    ("Kitware.CMake", []),
+    ("KhronosGroup.VulkanSDK", []),
+    ("Microsoft.VisualStudio.2022.BuildTools",
+     ["--override", "--quiet --wait --norestart --add Microsoft.VisualStudio.Workload.VCTools "
+                    "--includeRecommended"]),
+]
+
+
+# ---------- paths and detection ----------
+
+def cli_path() -> Path | None:
+    cfg = load_config()
+    for p in (cfg.get("whispercpp_cli"), BUILD_DIR / "bin" / "Release" / "whisper-cli.exe",
+              BUILD_DIR / "bin" / "whisper-cli.exe", BUILD_DIR / "bin" / "whisper-cli"):
+        if p and Path(p).is_file():
+            return Path(p)
+    return None
+
+
+def model_file(name: str) -> Path:
+    return WCPP_DIR / f"ggml-{name}.bin"
+
+
+def gpu_names() -> list[str]:
+    if not IS_WIN:
+        return []
+    r = subprocess.run(["powershell", "-NoProfile", "-Command",
+                        "(Get-CimInstance Win32_VideoController).Name"],
+                       capture_output=True, text=True, encoding="utf-8", errors="replace")
+    return [x.strip() for x in (r.stdout or "").splitlines() if x.strip()]
+
+
+def vulkan_gpu() -> str | None:
+    """Name of an AMD Radeon / Intel Arc card, if any (NVIDIA uses the CUDA path)."""
+    for n in gpu_names():
+        if re.search(r"radeon|\bamd\b|intel.*\barc\b", n, re.I) and not re.search(r"radeon\(tm\) graphics$", n, re.I):
+            return n
+    return None
+
+
+# ---------- install and build ----------
+
+def _cmake() -> str | None:
+    return which("cmake") or next(iter(glob.glob(r"C:\Program Files\CMake\bin\cmake.exe")), None)
+
+
+def _vulkan_sdk() -> str | None:
+    p = os.environ.get("VULKAN_SDK")
+    if p and Path(p).is_dir():
+        return p
+    if IS_WIN:
+        try:
+            import winreg
+            k = winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE,
+                               r"SYSTEM\CurrentControlSet\Control\Session Manager\Environment")
+            p = winreg.QueryValueEx(k, "VULKAN_SDK")[0]
+            if p and Path(p).is_dir():
+                return p
+        except OSError:
+            pass
+        found = sorted(glob.glob(r"C:\VulkanSDK\*"))
+        if found:
+            return found[-1]
+    return None
+
+
+def _has_msvc() -> bool:
+    vswhere = Path(os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)")) / \
+        "Microsoft Visual Studio" / "Installer" / "vswhere.exe"
+    if not vswhere.is_file():
+        return False
+    r = subprocess.run([str(vswhere), "-products", "*", "-requires",
+                        "Microsoft.VisualStudio.Component.VC.Tools.x86.x64", "-property", "installationPath"],
+                       capture_output=True, text=True, encoding="utf-8", errors="replace")
+    return bool(r.stdout.strip())
+
+
+def build_tools_status() -> dict:
+    return {"cmake": bool(_cmake()), "vulkan_sdk": bool(_vulkan_sdk()), "msvc": _has_msvc(),
+            "git": bool(which("git"))}
+
+
+def install_build_tools() -> None:
+    st = build_tools_status()
+    need = {"Kitware.CMake": not st["cmake"], "KhronosGroup.VulkanSDK": not st["vulkan_sdk"],
+            "Microsoft.VisualStudio.2022.BuildTools": not st["msvc"]}
+    for pkg, extra in WINGET_DEPS:
+        if need[pkg]:
+            log(f"  installing {pkg} with winget (Windows may ask for admin rights)...")
+            subprocess.run(["winget", "install", "-e", "--id", pkg, "--silent", "--accept-source-agreements",
+                            "--accept-package-agreements"] + extra)
+
+
+def build() -> tuple[bool, str]:
+    """Clone and compile whisper-cli with Vulkan. Returns (ok, message)."""
+    cmake, sdk, git = _cmake(), _vulkan_sdk(), which("git")
+    if not (cmake and sdk and git and _has_msvc()):
+        return False, f"missing build tools: {build_tools_status()}"
+    WCPP_DIR.mkdir(parents=True, exist_ok=True)
+    if not (SRC_DIR / "CMakeLists.txt").is_file():
+        log(f"  cloning whisper.cpp {TAG}...")
+        r = subprocess.run([git, "clone", "--depth", "1", "-b", TAG, REPO, str(SRC_DIR)],
+                           capture_output=True, text=True, encoding="utf-8", errors="replace")
+        if r.returncode != 0:
+            return False, "git clone failed: " + r.stderr[-300:]
+    env = dict(os.environ, VULKAN_SDK=sdk)
+    env["PATH"] = str(Path(sdk) / "Bin") + os.pathsep + env.get("PATH", "")
+    log("  compiling whisper.cpp with Vulkan (5-15 min, first time only)...")
+    steps = [
+        [cmake, "-S", str(SRC_DIR), "-B", str(BUILD_DIR), "-DGGML_VULKAN=ON", "-DWHISPER_BUILD_TESTS=OFF",
+         "-DWHISPER_BUILD_SERVER=OFF", "-DWHISPER_SDL2=OFF", "-DBUILD_SHARED_LIBS=OFF"],
+        [cmake, "--build", str(BUILD_DIR), "--config", "Release", "--target", "whisper-cli", "-j"],
+    ]
+    for cmd in steps:
+        r = subprocess.run(cmd, env=env, capture_output=True, text=True, encoding="utf-8", errors="replace")
+        if r.returncode != 0:
+            (WCPP_DIR / "build.log").write_text(r.stdout + "\n" + r.stderr, encoding="utf-8")
+            return False, f"build failed, see {WCPP_DIR / 'build.log'}"
+    return (True, "ok") if cli_path() else (False, "whisper-cli not found after build")
+
+
+def download_model(name: str) -> Path:
+    dst = model_file(name)
+    if dst.is_file() and dst.stat().st_size > 10_000_000:
+        return dst
+    WCPP_DIR.mkdir(parents=True, exist_ok=True)
+    part = dst.with_suffix(".part")
+    log(f"  downloading whisper.cpp model '{name}' (first time only)...")
+    req = urllib.request.Request(MODEL_URL.format(name), headers={"User-Agent": "stream-clipper"})
+    with urllib.request.urlopen(req, timeout=60) as r, open(part, "wb") as f:
+        while True:
+            b = r.read(1 << 20)
+            if not b:
+                break
+            f.write(b)
+    part.replace(dst)
+    return dst
+
+
+def test_gpu(model: str = "large-v3-turbo") -> tuple[bool, str]:
+    """Run whisper-cli on 2 s of a tone; ok if it ran on a Vulkan device."""
+    cli = cli_path()
+    if not cli:
+        return False, "whisper-cli not built"
+    mf = model_file(model)
+    if not mf.is_file():
+        return False, f"model {mf.name} missing"
