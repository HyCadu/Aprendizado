 def _pcm(path: Path, start: float, dur: float, sr: int = 8000) -> np.ndarray:
-    cmd = [ffmpeg(), "-v", "error", "-ss", f"{max(0, start):.3f}", "-t", f"{dur:.3f}", "-i", str(path),
