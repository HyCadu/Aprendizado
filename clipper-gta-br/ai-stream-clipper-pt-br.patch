+                          "pipe:1"], capture_output=True).stdout
+    n = len(raw) // (W * H * 3)
+    if n < fps * 3:
+        return {"status": "skipped", "reason": "could not read frames"}
+    f = np.frombuffer(raw[: n * W * H * 3], np.uint8).reshape(n, H, W, 3).astype(np.int16)
