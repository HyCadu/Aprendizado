+def which(name: str):
+    p = shutil.which(name)
+    if p:
+        return p
+    for d in _extra_bin_dirs():
+        for cand in (name + ".exe", name):
+            fp = os.path.join(d, cand)
+            if os.path.isfile(fp):
+                return fp
+    return None
