+             f"- Picking (Claude reading the chunks): {fmt_dur(rep['picking_seconds'] or 0)}",
+             f"- Render: {fmt_dur(rep['render_seconds'] or 0)}",
+             f"- Total: {fmt_dur(rep['total_seconds'] or 0)}", "", "## Clips"]
